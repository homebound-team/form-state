{
  "name": "@homebound/form-state",
  "version": "2.33.0",
  "author": "Homebound",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/homebound-team/form-state"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "build:storybook": "storybook build",
    "test": "vitest run",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "storybook": "storybook dev -p 9000",
    "format": "prettier --loglevel warn --write \"**/*.{ts,tsx,css,md}\"",
    "semantic-release": "semantic-release"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged --allow-empty"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,css,md}": "prettier --write"
  },
  "dependencies": {
    "@types/object-hash": "^3.0.6",
    "is-plain-object": "^5.1.0",
    "object-hash": "^3.0.0",
    "temporal-polyfill": "^0.3.2"
  },
  "peerDependencies": {
    "mobx": ">=6",
    "react": ">=16"
  },
  "devDependencies": {
    "@homebound/eslint-config": "^4.0.0",
    "@homebound/rtl-utils": "^3.0.2",
    "@homebound/tsconfig": "^1.2.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/types": "^8.6.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "husky": "^3.1.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^15.2.10",
    "mobx": "^7.0.3",
    "mobx-react": "^10.0.2",
    "oxlint": "~1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semantic-release": "^24.1.2",
    "storybook": "^8.6.14",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@4.18.0"
}
